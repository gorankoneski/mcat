# Required: Anthropic API key for the AI Study Counselor
ANTHROPIC_API_KEY=sk-ant-...

# Required: random 32+ byte secret for Auth.js session encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the web app (used by Auth.js for callbacks)
AUTH_URL=http://localhost:3000

# Sign in with Apple — create a Services ID + key at developer.apple.com
# APPLE_CLIENT_SECRET is the signed JWT generated from the .p8 key
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email magic-link provider (nodemailer SMTP URL)
# Example: smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=mcat@localhost
